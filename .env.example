# ----------------------------------------------------------------------------
# AI Manager Platform — environment template
# Copy to `.env` and fill in. Real `.env` files are git-ignored.
# ----------------------------------------------------------------------------

# Mandatory runtime root. On the operator's Windows workstation this MUST be:
#   C:\Users\ASUS\Desktop\AI Manager
# In dev on Linux/macOS, point it at a local directory you control.
AIM_ROOT=C:\Users\ASUS\Desktop\AI Manager

# ----- Database -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_manager
POSTGRES_USER=ai_manager
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ai_manager:change-me@postgres:5432/ai_manager

# ----- Cache / queue -----
REDIS_URL=redis://redis:6379/0

# ----- LLM (local, Ollama) -----
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_ROUTER=qwen2.5:7b-instruct
OLLAMA_MODEL_SYNTH=llama3.1:8b
OLLAMA_MODEL_EMBED=bge-m3

# ----- API / auth -----
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=replace-with-a-long-random-string
JWT_ALG=HS256
JWT_TTL_MIN=480

# ----- Frontend -----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# ----- Crawler (Regulyator) -----
CRAWL_CRON=0 3 * * *
CRAWL_ALLOWED_HOSTS=lex.uz,cbu.uz,ipakyulibank.uz

# ----- OCR -----
TESSERACT_LANGS=rus+uzb+uzb_cyrl+eng

# ----- AI Metodist (standalone wrapper) -----
# The `app.agents.metodist` sub-agent is a thin wrapper around the standalone
# `metodist-agent` Python package shipped alongside the corpus. To activate it,
# install the package into the platform venv:
#     pip install -e "C:\Users\ASUS\Desktop\AI Manager\KB\AI Metodist Agent"
# The wrapper reads ANTHROPIC_API_KEY from that folder's own .env. Override
# the path here if the standalone lives elsewhere.
METODIST_STANDALONE_PATH=C:\Users\ASUS\Desktop\AI Manager\KB\AI Metodist Agent

# ----- Behaviour toggles -----
# Demo / no-deps mode: stub agents, in-memory everything, admin/any-password
# login. Set to 1 to run the dashboard without Postgres/Redis/Ollama.
AIM_DEMO=0
# Auto-audit: when a regulator doc finishes ingesting, compare it against the
# internal KB and drop a finding in the notifications bell.
AIM_AUTO_AUDIT=1
# LLM-driven intent classification (Ollama router model). Falls back to the
# keyword rules on any failure. Set to 0 to force the keyword heuristic.
AIM_LLM_INTENT=1
